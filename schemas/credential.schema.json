{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pariksha-protocol.org/schemas/draft-01/credential.schema.json",
  "title": "Pariksha Credential Envelope",
  "description": "The single artifact type of the protocol (spec §2.1, §5): issuer → subject, claims, optional sealed payload, proof. Aligned with the W3C Verifiable Credentials Data Model v2 and extended with a sealed payload and quorum-wrapped key shares. The twelve credential types of §5 are values of `type[1]`.",
  "type": "object",
  "required": ["@context", "type", "issuer", "credentialSubject", "proof"],
  "properties": {
    "@context": {
      "type": "array",
      "items": { "type": "string" },
      "contains": { "const": "https://www.w3.org/ns/credentials/v2" }
    },
    "type": {
      "type": "array",
      "minItems": 2,
      "prefixItems": [
        { "const": "VerifiableCredential" },
        { "enum": [
          "AuthorityCredential", "RoleCredential", "DeviceCredential", "CandidateCredential",
          "ExamPaperCredential", "ResponseCredential", "MarksListCredential",
          "GrantCredential", "CapabilityToken",
          "ResultCredential", "AdmitCredential", "IntegrityCertificate"
        ] }
      ]
    },
    "id":     { "type": "string" },
    "issuer": { "type": "string" },
    "validFrom":  { "type": "string", "format": "date-time" },
    "validUntil": { "type": "string", "format": "date-time" },
    "credentialSubject": {
      "type": "object",
      "description": "Claims. Cross-cutting claims required on every type (spec §5): scope, issuing_authority, revocation_registry_uri, presentation_proof_type.",
      "required": ["scope", "issuing_authority", "revocation_registry_uri", "presentation_proof_type"],
      "properties": {
        "scope":                   { "type": "string", "description": "Context-bound, never global. e.g. exam:BOARD-2026-P1/centre:C012" },
        "issuing_authority":       { "type": "string" },
        "revocation_registry_uri": { "type": "string", "format": "uri" },
        "presentation_proof_type": { "enum": ["plain", "zk"] },
        "policy_variance_ref":     { "type": ["string", "null"], "description": "Witnessed justification event for any variance from baseline policy (spec §5, S4)." }
      },
      "additionalProperties": true
    },
    "payload": {
      "type": ["string", "null"],
      "description": "Sealed content, encrypted to the receiving context. Present on artifact-family types. Never plaintext."
    },
    "keyShares": {
      "type": "array",
      "description": "Content key shares, each wrapped to one quorum member's credential key (spec §7.1 d). Order matches quorum_policy.",
      "items": { "type": "string" }
    },
    "proof": {
      "type": "object",
      "required": ["type", "verificationMethod"],
      "properties": {
        "type":               { "type": "string" },
        "verificationMethod": { "type": "string" },
        "created":            { "type": "string", "format": "date-time" },
        "proofValue":         { "type": "string" }
      }
    }
  }
}
